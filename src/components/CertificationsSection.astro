---
import type { Locale } from "../lib/i18n";
import { translations } from "../lib/i18n";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale].certifications;

interface Certification {
  title: string;
  issuer: string;
  year: string;
  verifyUrl: string;
  image: string;
}

const certifications: Certification[] = [
  {
    title: "Developing Secure Software",
    issuer: "The Linux Foundation",
    year: "2026",
    verifyUrl: "https://www.credly.com/badges/6cfd4b7b-97a2-41ba-a9aa-dae369f89453",
    image: "/badges/credly-lfd121-secure-software-512.png",
  },
];
---

<section id="certificaciones" class="py-24 scroll-mt-14 sm:scroll-mt-16">
  <h2 class="section-heading font-mono text-xs tracking-widest uppercase text-ink-dim mb-12">
    {t.title}
  </h2>

  <div class="grid gap-5 sm:grid-cols-2">
    {certifications.map((cert) => (
      <div class="border border-line p-5 sm:p-6 flex gap-5 items-start">
        <img
          src={cert.image}
          alt={cert.title}
          width="112"
          height="112"
          loading="lazy"
          decoding="async"
          class="w-20 sm:w-28 h-auto shrink-0 border border-line bg-bg-raised badge-color-accent"
        />
        <div class="flex flex-col">
          <h3 class="font-mono text-xs tracking-widest uppercase text-ink mb-2">
            {cert.title}
          </h3>
          <p class="font-mono text-[11px] tracking-wider text-ink-dim uppercase mb-1">
            {cert.issuer} · {cert.year}
          </p>
          <a
            href={cert.verifyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 font-mono text-[11px] tracking-wider uppercase text-ink-dim hover:text-ink transition-colors duration-150"
          >
            {t.verify}
          </a>
        </div>
      </div>
      ))}
    </div>
  </div>
</section>

<style>
  .badge-color-accent {
    filter: none;
    opacity: 0.85;
    transition: filter 180ms ease-out, opacity 180ms ease-out;
  }

  .badge-color-accent:hover {
    filter: grayscale(1) contrast(1.05) brightness(0.9);
    opacity: 1;
  }
</style>
