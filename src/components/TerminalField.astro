<div id="terminal-field" aria-hidden="true" style="position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;">
  <div id="terminal-lines"></div>
</div>

<script is:inline>
  (() => {
    const container = document.getElementById("terminal-lines");
    if (!container) return;

    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const lines = [
      "ez@ez:~$ git status",
      "> On branch main — up to date",
      "ez@ez:~$ go build ./...",
      "> ok in 2.4s",
      "ez@ez:~$ kubectl get pods -n prod",
      "> 12 running / 0 pending",
      "ez@ez:~$ redis-cli ping",
      "> PONG",
      "ez@ez:~$ psql -d agro -c 'select count(*) from tenants'",
      ">  42",
      "ez@ez:~$ docker compose up -d",
      "> Started 4 containers ✓",
      "ez@ez:~$ sqlc generate",
      "> 12 queries generated",
      "ez@ez:~$ go test ./... -race",
      "> ok  3.1s  (42 tests)",
      "ez@ez:~$ terraform plan",
      "> Plan: 3 to add, 0 to change",
      "ez@ez:~$ curl -s localhost:8080/healthz",
      '> {"status":"ok"}',
      "ez@ez:~$ kubectl rollout status deploy/iam",
      '> deployment "iam" successfully rolled out',
      "ez@ez:~$ openssl rand -hex 32",
      "> c4f3…b91 (rotated)",
      "ez@ez:~$ ssh deploy@prod",
      "> Connected ✓",
      "ez@ez:~$ git push origin main",
      "> main → origin (fast-forward)",
      "ez@ez:~$ go vet ./...",
      "> no issues found",
      "ez@ez:~$ make migrate",
      "> migrations applied (2026.09.05)",
      "ez@ez:~$ cd ~/agro-agent && go run ./cmd/api",
      "> listening on :8080 ✓",
    ];

    if (prefersReduced) {
      for (const line of lines) {
        const p = document.createElement("p");
        p.textContent = line;
        container.appendChild(p);
      }
      return;
    }

    const MAX_VISIBLE = 26;
    let lineIndex = 0;
    let charIndex = 0;
    let currentEl = null;
    let timeoutId = null;

    function addLine() {
      const el = document.createElement("p");
      el.classList.add("active");
      container.appendChild(el);
      while (container.children.length > MAX_VISIBLE) {
        container.removeChild(container.firstChild);
      }
      return el;
    }

    function completeLine(el) {
      el.classList.remove("active");
    }

    function tick() {
      if (!currentEl) {
        currentEl = addLine();
      }

      const line = lines[lineIndex % lines.length];

      if (charIndex === 0) {
        currentEl.textContent = "";
      }

      if (charIndex < line.length) {
        currentEl.textContent = line.slice(0, charIndex + 1) + "\u007C";
        charIndex++;
        schedule(30 + Math.random() * 50);
      } else {
        currentEl.textContent = line;
        completeLine(currentEl);
        lineIndex = (lineIndex + 1) % lines.length;
        charIndex = 0;
        currentEl = null;
        schedule(700 + Math.random() * 500);
      }
    }

    function schedule(delay) {
      if (timeoutId) clearTimeout(timeoutId);
      timeoutId = setTimeout(tick, delay);
    }

    schedule(500);
  })();
</script>

<style is:global>
  #terminal-lines {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-ink);
    user-select: none;
  }

  #terminal-lines p {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    opacity: 0.12;
    transition: opacity 0.4s ease;
  }

  #terminal-lines p.active {
    opacity: 0.28;
  }

  @media (prefers-reduced-motion: reduce) {
    #terminal-field {
      opacity: 0.08 !important;
    }
    #terminal-lines p {
      opacity: 1 !important;
      transition: none !important;
    }
    #terminal-lines p.active {
      opacity: 1 !important;
    }
  }
</style>