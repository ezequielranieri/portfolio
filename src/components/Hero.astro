---
import TerminalField from "./TerminalField.astro";
import type { Locale } from "../lib/i18n";
import { translations } from "../lib/i18n";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale].hero;
const s = translations[locale].nav;
---

<section id="inicio" class="relative min-h-screen flex flex-col overflow-hidden scroll-mt-0">
  <TerminalField />
  <div class="relative z-10 flex-1 flex flex-col items-center justify-center text-center px-4 sm:px-6 py-20">
    <p class="font-mono text-xs sm:text-sm tracking-widest uppercase text-ink-dim mb-6">
      {t.subtitle}
    </p>
    <h1 class="font-display text-[clamp(2.5rem,8vw,6rem)] leading-[1.05] tracking-tight text-ink select-none">
      EZEQUIEL<br />RANIERI
    </h1>
    <p class="mt-4 font-mono text-xs tracking-widest uppercase text-accent select-none">
      {t.tagline}
    </p>
    <div class="mt-6 flex flex-col items-center select-none">
      <div class="flex items-center justify-center gap-4">
        <a
          href="https://www.credly.com/badges/6cfd4b7b-97a2-41ba-a9aa-dae369f89453"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.badgeLabel}
        >
          <img
            src="/badges/credly-lfd121-secure-software-512.png"
            alt=""
            width="56"
            height="56"
            decoding="async"
            class="w-14 h-14 badge-color-accent"
          />
        </a>
        <a
          href="https://www.credly.com/badges/5a40b7c0-c673-4cb9-8845-1b2b9212eac3/public_url"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.badgeLabel2}
        >
          <img
            src="/badges/lfel1012-secure-ai-ml-driven-software-development-512.png"
            alt=""
            width="56"
            height="56"
            decoding="async"
            class="w-14 h-14 badge-color-accent"
          />
        </a>
      </div>
      <p class="mt-1.5 font-mono text-[11px] tracking-widest uppercase text-ink-dim">
        {t.badgeCaption}
      </p>
    </div>
    <p class="mt-6 max-w-md mx-auto text-ink-dim text-sm sm:text-base leading-relaxed" style="color: var(--color-ink-dim);">
      {t.bio}
    </p>
    <div class="mt-10 flex flex-wrap gap-3 justify-center">
      <a
        href={"/" + locale + "/#proyectos"}
        class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-mono tracking-wider border border-line text-ink-dim hover:bg-ink hover:text-bg transition-colors duration-150"
      >
        {t.ctaProjects}
      </a>
      <a
        href={"/" + locale + "/#blog"}
        class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-mono tracking-wider border border-line text-ink-dim hover:bg-ink hover:text-bg transition-colors duration-150"
      >
        {t.ctaBlog}
      </a>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
    <div class="w-5 h-8 border border-line rounded-none relative overflow-hidden">
      <div class="scroll-indicator-inner absolute left-1/2 -translate-x-1/2 w-0.5 h-3 bg-ink-dim"></div>
    </div>
  </div>
</section>

<style>
  .badge-color-accent {
    filter: none;
    opacity: 0.85;
    transition: filter 180ms ease-out, opacity 180ms ease-out;
  }

  .badge-color-accent:hover {
    filter: grayscale(1) contrast(1.05) brightness(0.9);
    opacity: 1;
  }

  .scroll-indicator-inner {
    top: 4px;
    animation: scroll-wheel 1.8s ease-in-out infinite;
  }

  @keyframes scroll-wheel {
    0%, 100% { top: 4px; }
    50% { top: 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator-inner {
      animation: none;
    }
  }
</style>
